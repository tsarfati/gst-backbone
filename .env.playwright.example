# Base URL for the app under test.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8086

# Internal BuilderLYNK user for main auth smoke test.
PW_INTERNAL_USER_EMAIL=
PW_INTERNAL_USER_PASSWORD=

# Vendor portal user + company-specific login URL.
PW_VENDOR_USER_EMAIL=
PW_VENDOR_USER_PASSWORD=
PW_VENDOR_LOGIN_URL=http://127.0.0.1:8086/vendor-login?company=
PW_VENDOR_EXPECTED_COMPANY_NAME=

# Same-email user that has both BuilderLYNK internal and vendor access.
PW_SAME_EMAIL_USER_EMAIL=
PW_SAME_EMAIL_USER_PASSWORD=

# User that should land on the workspace chooser after main-site login.
PW_WORKSPACE_CHOOSER_USER_EMAIL=
PW_WORKSPACE_CHOOSER_USER_PASSWORD=
